<header class="border-bottom bg-white py-4">
  <nav class="navbar navbar-expand-lg">
    <div class="container">

      <%= link_to "MyApp", root_path, class: "navbar-brand fw-bold" %>

      <div class="ms-auto d-flex align-items-center gap-2">

        <%= form_with url: search_posts_path, method: :get, local: true, class: "d-flex xx" do |f| %>
          <%= f.search_field :q, value: params[:q], class: "form-control me-2", placeholder: "投稿を検索" %>
          <%= f.submit "検索", class: "btn btn-outline-primary" %>
        <% end %>

        <%= link_to t('header.post_index'), posts_path, class: "btn btn-outline-secondary" %>
        <%= link_to t('header.create_post'), new_post_path, class: "btn btn-outline-warning" %>
        <%= link_to t('header.profile'), profile_path, class: "btn btn-outline-primary" %>
        <%= button_to t('header.logout'), logout_path, method: :delete, class: "btn btn-outline-danger" %>

      </div>
    </div>
  </nav>
</header>
