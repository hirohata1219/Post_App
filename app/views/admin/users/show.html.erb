<div class="py-5 col-md-5 mx-auto">

  <h1 class="text-center fw-bold mb-4">
    ユーザー詳細
  </h1>

  <dl>
    <dt>ID</dt>
    <dd><%= @user.id %></dd>

    <dt>名前</dt>
    <dd><%= @user.name %></dd>

    <dt>メールアドレス</dt>
    <dd><%= @user.email %></dd>

    <dt>権限</dt>
    <dd><%= @user.role %></dd>
  </dl>
  <div class="mb-3 d-flex gap-3">
    <%= button_to "削除", admin_user_path(@user), method: :delete, data: { turbo_confirm: "本当に削除しますか？" },
               class: "btn btn-danger btn-sm" %>
    <%= link_to "権限を変更", edit_admin_user_path(@user), class: "btn btn-primary btn-sm" %>
  </div>
  <div class="text-center pt-5">
    <%= link_to "ユーザー一覧へ戻る", admin_users_path %>
  </div>
</div>