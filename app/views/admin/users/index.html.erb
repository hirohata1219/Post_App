<div class="py-5 col-md-8 mx-auto">

  <h1 class="text-center fw-bold mb-5">
    ユーザー管理
  </h1>

  <table class="table">
    <thead>
      <tr>
        <th>ID</th>
        <th>名前</th>
        <th>メールアドレス</th>
        <th>権限</th>
        <th></th>
      </tr>
    </thead>

    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td><%= user.id %></td>
          <td><%= user.name %></td>
          <td><%= user.email %></td>
          <td><%= user.role %></td>
          <td class="d-flex gap-2">
            <%= link_to "詳細", admin_user_path(user), class: "btn btn-outline-primary btn-sm" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

</div>