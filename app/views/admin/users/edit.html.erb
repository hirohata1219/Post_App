<div class="py-5 col-md-5 mx-auto">

  <h1 class="text-center fw-bold mb-4">
    ユーザー権限変更
  </h1>

  <%= form_with model: [:admin, @user] do |f| %>

    <div class="mb-5 pb-5">
      <%= f.label :role, "権限", class: "form-label" %>
      <%= f.select :role, User.roles.keys.map { |role| [role, role] }, {}, class: "form-select" %>
    </div>

    <div class="text-center">
      <%= f.submit "更新", class: "btn btn-primary w-50" %>
    </div>

  <% end %>

</div>