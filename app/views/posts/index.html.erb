<% content_for :title, t('.title') %>

<div class="container py-4">
  <div class="mx-auto" style="max-width: 800px;">

    <h1 class="py-5 text-center"><%= t('.title') %></h1>

    <% if @posts.any? %>

      <% @posts.each do |post| %>
        <article class="card mb-3 p-3">
          <div class="card-body">

            <h2>
              <%= link_to post.title, post_path(post), class: "text-decoration-none" %>
            </h2>

          <%# 三項演算子で条件分岐 %>
            <%= render 'posts/poster', post: post %>

            <p>
              <%= truncate(post.body, length: 100) %>
            </p>

            <% if post.user == current_user %>
              <%= link_to t('defaults.edit'),
                          edit_post_path(post),
                          class: "btn btn-outline-secondary btn-sm" %>

              <%= link_to t('defaults.delete'),
                          post_path(post),
                          class: "btn btn-outline-danger btn-sm",
                          data: {
                            turbo_method: :delete,
                            turbo_confirm: t('defaults.delete_confirm')
                          } %>
            <% end %>

          </div>
        </article>
      <% end %>
      
      <div class="d-flex justify-content-center">
        <%= paginate @posts %>
      </div>

    <% else %>

      <p class="text-center">
        <%= t('.no_result') %>
      </p>
      
    <% end %>

  </div>
</div>
