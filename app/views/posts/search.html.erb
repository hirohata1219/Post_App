<div class="container py-5 d-flex flex-column align-items-center">

  <h1 class="py-4">検索結果</h1>

  <%= form_with url: search_posts_path,
                method: :get,
                local: true,
                class: "mb-4" do |f| %>

    <div class="input-group">
      <%= f.search_field :q,
                         value: @query,
                         class: "form-control",
                         placeholder: "キーワードを入力" %>

      <%= f.submit "検索", class: "btn btn-primary" %>
    </div>

  <% end %>

  <% if @query.blank? %>

    <div class="alert alert-info">
      検索キーワードを入力してください。
    </div>

  <% elsif @posts.empty? %>

    <div class="alert alert-warning">
      「<%= @query %>」に一致する投稿はありません。
    </div>

  <% else %>

    <p class="mb-3">
      「<%= @query %>」の検索結果
    </p>

    <% @posts.each do |post| %>

      <div class="card my-5 p-5">
        <div class="card-body">

          <h2 class="h5">
            <%= link_to post.title, post_path(post) %>
          </h2>

          <p>
            <%= truncate(post.body, length: 150) %>
          </p>

          <%# 三項演算子で条件分岐 %>
            <%= render 'posts/poster', post: post %>

        </div>
      </div>

    <% end %>

    <div class="d-flex justify-content-center mt-4">
      <%= paginate @posts %>
    </div>

  <% end %>

</div>
