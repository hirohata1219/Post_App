<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <h1 class="mb-4 text-center">パスワードをお忘れの方</h1>

      <%= form_with url: password_reset_path, method: :post do |form| %>

        <div class="mb-5">
          <%= form.label :email, "メールアドレス", class: "form-label" %>
          <%= form.email_field :email, class: "form-control", required: true, autocomplete: "email" %>
        </div>

        <div class="text-center">
          <%= form.submit "パスワード再設定メールを送信", class: "btn btn-primary" %>
        </div>

      <% end %>
    </div>
  </div>
</div>