<% content_for :title, t('.title') %>

<div class="container py-5">

  <h1 class="text-center fw-bold mb-4">
    <%= t('.title') %>
  </h1>

  <div class="mx-auto" style="max-width: 600px;">

    <%= form_with url: login_path do |f| %>

      <div class="mb-3">
        <%= f.label :email, t('activerecord.attributes.user.email'), class: "form-label" %>

        <%= f.email_field :email,
                          placeholder: t('defaults.email_placeholder'),
                          class: "form-control" %>
      </div>

      <div class="mb-5">
        <%= f.label :password, t('activerecord.attributes.user.password'), class: "form-label" %>

        <%= f.password_field :password,
                             placeholder: t('defaults.password_placeholder'),
                             class: "form-control" %>
      </div>

      <div class="d-grid mb-5">
        <%= f.submit t('.login'), class: "btn btn-primary" %>
      </div>

      <div class="text-center mb-3">
        <%= link_to "パスワードをお忘れの方はこちら", new_password_reset_path %>
      </div>

      <div class="text-center">
        <%= link_to t('.to_register_page'), new_user_path %>
      </div>

    <% end %>

  </div>

</div>